# Admin token of dx01v2 (contract: 48 random alphanumeric characters). Generated by an
# ephemeral resource and written with a write-only argument: never in plan or state.

ephemeral "random_password" "admin_token" {
  length  = 48
  special = false
}

resource "aws_secretsmanager_secret" "admin_token" {
  name                    = "${local.name}/app/admin-token"
  description             = "ADMIN_TOKEN of dx01v2 (plain string, 48 alphanumeric characters)."
  kms_key_id              = module.kms.key_arn
  recovery_window_in_days = var.secret_recovery_window_days
  dynamic "replica" {
    for_each = var.db_profile == "dr" ? { (var.dr_region) = module.kms_dr[0].key_arn } : {}
    content {
      region     = replica.key
      kms_key_id = replica.value
    }
  }
}

resource "aws_secretsmanager_secret_version" "admin_token" {
  secret_id                = aws_secretsmanager_secret.admin_token.id
  secret_string_wo         = ephemeral.random_password.admin_token.result
  secret_string_wo_version = var.admin_token_version
}
