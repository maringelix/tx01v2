// Linux environment for the harness and the local lab (Windows and macOS contributors), with
// Docker-in-Docker for `make e2e`. `make tools` installs the pinned tools into .tools/ on creation;
// then run `make verify` and `make e2e` (Docker needs about 8 GB of memory for the full lab).
{
  "name": "tx01v2",
  // mcr.microsoft.com/devcontainers/base:ubuntu-24.04, pinned by digest (verified 2026-10-10)
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04@sha256:d94c97dd9cacf183d0a6fd12a8e87b526e9e928307674ae9c94139139c0c6eae",
  "features": {
    // docker-in-docker 2.17.0, pinned by digest (the same as the app repositories, verified 2026-10-10)
    "ghcr.io/devcontainers/features/docker-in-docker@sha256:25b9f05705ffba7dbe503230ac76081419306f8c8bc88e0ce78c4ecd99a0c78c": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "postCreateCommand": "make tools",
  "remoteEnv": {
    "HARNESS_STRICT": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform",
        "timonwong.shellcheck",
        "redhat.vscode-yaml",
        "editorconfig.editorconfig"
      ]
    }
  }
}
