# Charts of the local platform (platform/local/install.sh, verified 2026-10-12). Values: KEY=VALUE, no
# quotes (read without executing the file). install.sh and the harness pull <chart> <version> from the
# repository and refuse an archive whose SHA256 differs from *_SHA256. Image digests live in
# platform/local/values/*.yaml. Update procedure: docs/SUSTENTACAO.md (lab local).
#
# Gateway API CRDs, standard channel (Istio 1.31 documents v1.6.0; v1.6.3 is the latest patch).
GATEWAY_API_VERSION=v1.6.3
GATEWAY_API_SHA256=356c2b8e286a964dc20995435659ad1095386329974793af10bbfe3eff977fe5
# Istio 1.31.1, ambient mode (supports Kubernetes 1.32 to 1.37; EOL ~2027-02).
ISTIO_REPO=https://blob.istio.io/istio-release/charts
ISTIO_VERSION=1.31.1
ISTIO_BASE_SHA256=6a5f3a628e31ea03994f5c8ff44804fcec54ac1b13893f1a3f3c26340c8f2015
ISTIOD_SHA256=d49e3ac3100e9c24efbd3a7c26e8e6dd707431f8c06f203182ba54a2e8651a74
ISTIO_CNI_SHA256=e7cfcbd6842f0b23026dc81bd99edd0e5da87d9f5e2e75b45a2dc2a69f873127
ZTUNNEL_SHA256=6fa9f7f88ae68fe7c84df4ef09711639bc8bc38b31769e85336676ebd8ae70b5
# cert-manager v1.21.2 (CA ClusterIssuer lab-ca, Gateway API support on).
