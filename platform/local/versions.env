CERT_MANAGER_VERSION=v1.21.2
CERT_MANAGER_SHA256=73a56e1728edd6c99f1f31082618c3259d279a76b7ebd3d4bdc5475c2442d34a
# External Secrets Operator: the same chart as the cloud platform (platform/versions.env ESO_CHART_VERSION).
ESO_REPO=https://charts.external-secrets.io
