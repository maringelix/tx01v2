# Versions installed by platform/install.sh (verified 2026-10-10). Update procedure:
# docs/SUSTENTACAO.md. Image digests live in platform/values/*.yaml.
#
# AWS Load Balancer Controller (eks-charts): since v3.0.0 the chart version equals the app version.
# Must match local.load_balancer_controller_version in terraform/modules/eks/pod_identity.tf.
LBC_CHART_VERSION=3.6.0
# SHA256 of terraform/modules/eks/policies/aws-load-balancer-controller-v3.6.0.json, a verbatim copy
# of docs/install/iam_policy.json at tag v3.6.0 of kubernetes-sigs/aws-load-balancer-controller.
LBC_IAM_POLICY_SHA256=16f232c9d9f79366fe949c4550ad517a202380058a9e48d45a4e215044a20a6a
# External Secrets Operator (charts.external-secrets.io), app v2.12.0, CRDs served as external-secrets.io/v1.
ESO_CHART_VERSION=2.12.0
# OpenTelemetry Collector (open-telemetry.github.io/opentelemetry-helm-charts), Collector contrib
# 0.162.0 (verified 2026-10-14); the local lab installs the same chart (platform/local/versions.env).
OTEL_COLLECTOR_CHART_VERSION=0.176.0
