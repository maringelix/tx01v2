# Versions installed by platform/install.sh (verified 2026-10-10). Update procedure:
# docs/MAINTENANCE.md. Image digests live in platform/values/*.yaml.
#
# AWS Load Balancer Controller (eks-charts): since v3.0.0 the chart version equals the app version.
# Must match local.load_balancer_controller_version in terraform/modules/eks/pod_identity.tf.
LBC_CHART_VERSION=3.6.0
# SHA256 of terraform/modules/eks/policies/aws-load-balancer-controller-v3.6.0.json, a verbatim copy
# of docs/install/iam_policy.json at tag v3.6.0 of kubernetes-sigs/aws-load-balancer-controller.
LBC_IAM_POLICY_SHA256=16f232c9d9f79366fe949c4550ad517a202380058a9e48d45a4e215044a20a6a
# ExternalDNS (only installed when the optional public DNS contract is enabled).
EXTERNAL_DNS_REPO=https://kubernetes-sigs.github.io/external-dns
EXTERNAL_DNS_CHART_VERSION=1.23.0
EXTERNAL_DNS_CHART_SHA256=6d149b9b04db1dc9e46b3693a4eca4ac90d6bba5e3b2a0fdd067ce3f7bfbc31e
EXTERNAL_DNS_IMAGE_TAG=v0.23.0
EXTERNAL_DNS_IMAGE_DIGEST=sha256:1854499e2b08cee47c40a08e356bff20dcb192dbcfde8378fc3f900f12cad5a3
# Kyverno 3.8.2 (v1.18.2): ImageValidatingPolicy enforces the exact GitHub Actions signer on app images.
KYVERNO_REPO=https://kyverno.github.io/kyverno
KYVERNO_VERSION=3.8.2
KYVERNO_SHA256=f4fc787cf1d6781eefb9e9b45837edcddcfae984c872888289914e97207cc5de
# External Secrets Operator (charts.external-secrets.io), app v2.12.0, CRDs served as external-secrets.io/v1.
ESO_CHART_VERSION=2.12.0
# OpenTelemetry Collector (open-telemetry.github.io/opentelemetry-helm-charts), Collector contrib
# 0.162.0 (verified 2026-10-14): the traces of the app, to AWS X-Ray. The local lab installs the same
# chart; install.sh, the harness and the local lab refuse an archive whose SHA256 differs from
# OTEL_COLLECTOR_CHART_SHA256.
OTEL_COLLECTOR_CHART_VERSION=0.176.0
OTEL_COLLECTOR_CHART_SHA256=8d3f0c6efd2ae33a8c843b189b86d9f93f52422bccbb5be35c5ac24154e24868
